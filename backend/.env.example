NODE_ENV=production
PORT=3002
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/shelfwise?retryWrites=true&w=majority
ADMIN_NAME=Library Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
# Optional email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional SMS reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
